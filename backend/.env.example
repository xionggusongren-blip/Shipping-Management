# IBM i 接続設定（IBM i Access ODBC Driver を使用）
IBMI_HOST=192.168.3.230
IBMI_USER=your_user
IBMI_PASSWORD=your_password
IBMI_LIBRARY=TREED
IBMI_TABLE=RJU1
IBMI_STAFF_LIBRARY=MUS1   # 担当者マスタ ライブラリ
IBMI_STAFF_TABLE=TREED    # 担当者マスタ ファイル

# アプリ設定
APP_SECRET_KEY=change-this-to-a-strong-random-secret-key
APP_ENV=development

# SQLite DB パス（backendフォルダ直下に作成されます）
DATABASE_URL=sqlite:///./shipping.db

# デモモード（true: サンプルデータ / false: IBM i 実データ）
DEMO_MODE=true
