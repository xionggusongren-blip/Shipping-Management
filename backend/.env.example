# IBM i 接続設定
IBMI_HOST=192.168.3.230
IBMI_USER=your_user
IBMI_PASSWORD=your_password
IBMI_LIBRARY=TREED
IBMI_TABLE=RJU1
# jt400.jar のパス（Windows形式で記載）
IBMI_DRIVER_PATH=C:\jt400\jt400.jar

# アプリ設定
APP_SECRET_KEY=change-this-to-a-strong-random-secret-key
APP_ENV=development

# SQLite DB パス（backendフォルダ直下に作成されます）
DATABASE_URL=sqlite:///./shipping.db

# デモモード（IBM i未接続時にサンプルデータを使用: true / 本番: false）
DEMO_MODE=true
